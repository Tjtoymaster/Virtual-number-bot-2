const database = require('../database/database');
const paystack = require('../services/paystack');
const orderService = require('../services/orderService');
const logger = require('../utils/logger');

const POLL_INTERVAL_MS = Number(process.env.PAYSTACK_POLL_INTERVAL_MS || 20000);
const MAX_ORDER_AGE_MS = 60 * 60 * 1000;

let timer = null;
let running = false;

async function pollOnce() {
  if (running) return;
  running = true;

  try {
    const db = database.getDatabase();

    const pending = Object.values(db.orders || {}).filter(order => {
      return (
        order.status === 'pending_payment' &&
        order.paymentMethod === 'paystack' &&
        order.paymentReference &&
        Date.now() - new Date(order.createdAt).getTime() < MAX_ORDER_AGE_MS
      );
    });

    for (const order of pending) {
      try {
        const verification = await paystack.verifyPayment(order.paymentReference);

        if (verification.status === 'success') {
          logger.info(`Payment poller: success detected for ${order.paymentReference}`);

          await orderService.completePaymentByReference(order.paymentReference, {
            event: 'payment.poll',
            reference: order.paymentReference,
            status: 'success',
            amount: Number(verification.amount) || Number(order.amountKobo),
            currency: verification.currency || order.currency,
            raw: verification.raw
          });
        } else if (verification.status === 'failed') {
          logger.info(`Payment poller: failure detected for ${order.paymentReference}`);

          await orderService.completePaymentByReference(order.paymentReference, {
            event: 'payment.poll',
            reference: order.paymentReference,
            status: 'failed',
            amount: 0,
            raw: verification.raw
          });
        }
      } catch (err) {
        logger.warn(`Payment poller: verify failed for ${order.paymentReference}: ${err.message}`);
      }
    }
  } finally {
    running = false;
  }
}

function start() {
  timer = setInterval(() => {
    pollOnce().catch(err => logger.error('Payment poller error:', err));
  }, POLL_INTERVAL_MS);

  logger.info(`Paystack payment poller started. Interval: ${POLL_INTERVAL_MS}ms`);
}

function stop() {
  if (timer) {
    clearInterval(timer);
    timer = null;
  }
}

module.exports = {
  start,
  stop,
  pollOnce
};